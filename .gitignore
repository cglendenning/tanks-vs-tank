# The only .gitignore in this repository. Every rule says why its paths stay out of git.

# Unity: caches, temp files and per-user editor state, all regenerated by the editor (Library alone is about 6 GB).
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/UserSettings/
/.utmp/
# Rewritten by Unity's External Dependency Manager on every Android dependency resolve, with machine-specific paths.
/ProjectSettings/AndroidResolverDependencies.xml

# IDE project files, generated from the Unity project by Visual Studio, Rider or MonoDevelop.
*.csproj
*.sln
*.user
*.userprefs
*.pidb
*.booproj
*.svd
/.vs/

# Build output and release binaries: rebuilt from source, large, and signed artifacts never belong in git.
/Builds/
*.apk
*.aab
*.ipa
*.xcarchive/
# CocoaPods output inside generated iOS projects.
Pods/
Podfile.lock

# Logs from Unity batch runs and tools (the build scripts write theirs under Logs/).
*.log

# Rendered ads from marketing/video/build_video_ads.py, regenerated by running it.
/marketing/video/out/

# Claude Code: per-machine permission settings, and isolated worktrees (separate checkouts of this repository).
/.claude/settings.local.json
/.claude/worktrees/

# macOS Finder metadata.
.DS_Store

# Firebase client config: regenerate locally (see README), never published; this repository is public.
Assets/GoogleService-Info.plist
Assets/GoogleService-Info.plist.meta
Assets/google-services.json
Assets/google-services.json.meta
Assets/StreamingAssets/google-services-desktop.json
Assets/StreamingAssets/google-services-desktop.json.meta
# Generated from google-services.json by the Firebase Unity plugin; carries the same API key.
Assets/Plugins/Android/FirebaseApp.androidlib/res/values/google-services.xml
Assets/Plugins/Android/FirebaseApp.androidlib/res/values/google-services.xml.meta
